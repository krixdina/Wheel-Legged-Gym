<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheel_legged_msgs</name>
  <version>0.1.0</version>
  <description>
    Custom ROS2 messages for sim2real serial-debug visualization: DebugState
    (all 21 uplink state quantities) and DebugAction (shared by the raw and the
    scaled 6-dim action).
  </description>
  <maintainer email="vjhgvj305@gmail.com">cristina</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>std_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
